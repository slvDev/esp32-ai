# python
__pycache__/
.venv/
*.pyc
*.egg-info/

# data + tokenizers (regenerate with research/tinystories/prepare.py)
data/*.bin
data/*.txt
data/*.json

# training outputs
runs/

# model artifacts: fetched from the model registry, or written by the
# reproduction exporter
/artifacts/

# headers each sketch generates from those artifacts
firmware/**/generated/

# ESP-IDF generated dependency/build output
firmware/**/build*/
firmware/**/managed_components/
firmware/**/dependencies.lock
firmware/**/.cache/
firmware/**/sdkconfig
firmware/**/sdkconfig.old
firmware/**/*.zip
firmware/**/results/
firmware/**/assets/result_*.jpg

# local research caches; keep scripts and small result JSONs reviewable
research/**/models/
research/**/data/*.npy
research/**/data/*.f32

# raw video / recordings (demo footage - keep out of the repo)
video/
videos/
*.mp4
*.mov
*.MOV
*.MP4

# host_verify build output (regenerate: see runtime/host_verify/)
*.obj
*.exe
val_tokens.bin

# -fstack-usage reports, regenerated every build
*.su
